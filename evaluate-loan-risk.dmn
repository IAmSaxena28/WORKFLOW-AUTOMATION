        <inputEntry id="UnaryTests_0540znd">
          <text>-</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0h2rp64">
          <text>"HIGH"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1llbg0e">
          <text> false</text>
