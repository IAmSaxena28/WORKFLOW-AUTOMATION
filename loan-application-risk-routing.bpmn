  <bpmn:process id="Process_0uaglcz" name="Underwriter Review" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Loan Application Submitted">
      <bpmn:outgoing>Flow_171fb10</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_171fb10" sourceRef="StartEvent_1" targetRef="Activity_1y8x1hn" />
    <bpmn:businessRuleTask id="Activity_1y8x1hn" name="Evaluate Loan Risk">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="evaluate-loan-risk" resultVariable="riskResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_171fb10</bpmn:incoming>
      <bpmn:outgoing>Flow_19menr5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_0sujnkm" name="Risk Routing">
      <bpmn:incoming>Flow_19menr5</bpmn:incoming>
      <bpmn:outgoing>Flow_0djfxg4</bpmn:outgoing>
      <bpmn:outgoing>Flow_0rdq0hj</bpmn:outgoing>
      <bpmn:outgoing>Flow_19irvpi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_19menr5" sourceRef="Activity_1y8x1hn" targetRef="Gateway_0sujnkm" />
    <bpmn:sequenceFlow id="Flow_0djfxg4" sourceRef="Gateway_0sujnkm" targetRef="Activity_0k8k18p">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskResult.riskTier = "LOW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_0k8k18p" name="Auto-Approve and Disburse">
      <bpmn:incoming>Flow_0djfxg4</bpmn:incoming>
      <bpmn:outgoing>Flow_04nkdhq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0rdq0hj" sourceRef="Gateway_0sujnkm" targetRef="Activity_1xf92h6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskResult.riskTier = "MEDIUM" or riskResult.requiresManualReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_1xf92h6" name="Underwriter Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0rdq0hj</bpmn:incoming>
      <bpmn:outgoing>Flow_0fv89vw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_19irvpi" sourceRef="Gateway_0sujnkm" targetRef="Activity_0ty1om7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskResult.riskTier = "HIGH" and riskResult.requiresManualReview = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_0ty1om7" name="Auto-Reject Notification">
      <bpmn:incoming>Flow_19irvpi</bpmn:incoming>
      <bpmn:outgoing>Flow_11duo92</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_1t3n3qn" name="Loan Approved">
      <bpmn:incoming>Flow_04nkdhq</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_04nkdhq" sourceRef="Activity_0k8k18p" targetRef="Event_1t3n3qn" />
    <bpmn:endEvent id="Event_0nnr0u1" name="Review Completed">
      <bpmn:incoming>Flow_0fv89vw</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0fv89vw" sourceRef="Activity_1xf92h6" targetRef="Event_0nnr0u1" />
    <bpmn:endEvent id="Event_0mhkgew" name="Loan Rejected">
      <bpmn:incoming>Flow_11duo92</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_11duo92" sourceRef="Activity_0ty1om7" targetRef="Event_0mhkgew" />
  </bpmn:process>
