  <bpmn:process id="Process_05x6a0c" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Order Received">
      <bpmn:outgoing>Flow_1jnxdrh</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1jnxdrh" sourceRef="StartEvent_1" targetRef="Activity_08sxee2" />
    <bpmn:businessRuleTask id="Activity_08sxee2" name="Calculate Total Discount">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="calculate-discounts" resultVariable="totalDiscount" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1jnxdrh</bpmn:incoming>
      <bpmn:outgoing>Flow_1nfu9k0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_1nfu9k0" sourceRef="Activity_08sxee2" targetRef="Activity_1p48xqk" />
    <bpmn:scriptTask id="Activity_1p48xqk" name="Calculate Final Invoice">
      <bpmn:extensionElements>
        <zeebe:script expression="=cartValue * (1 - (totalDiscount / 100))" resultVariable="finalAmount" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1nfu9k0</bpmn:incoming>
      <bpmn:outgoing>Flow_02jlp51</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_09178wu" name="Check Final Amount">
      <bpmn:incoming>Flow_02jlp51</bpmn:incoming>
      <bpmn:outgoing>Flow_0dex12w</bpmn:outgoing>
      <bpmn:outgoing>Flow_0m2ce8y</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_02jlp51" sourceRef="Activity_1p48xqk" targetRef="Gateway_09178wu" />
    <bpmn:sequenceFlow id="Flow_0dex12w" sourceRef="Gateway_09178wu" targetRef="Activity_1kz9yoy">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=finalAmount &gt;= 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_1kz9yoy" name="Manager Sign-off">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0dex12w</bpmn:incoming>
      <bpmn:outgoing>Flow_14xlapf</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0m2ce8y" sourceRef="Gateway_09178wu" targetRef="Activity_1xba2td">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=finalAmount &lt; 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_1xba2td" name="Send Order to Warehouse">
      <bpmn:incoming>Flow_0m2ce8y</bpmn:incoming>
      <bpmn:incoming>Flow_14xlapf</bpmn:incoming>
      <bpmn:outgoing>Flow_0yuub72</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_14xlapf" sourceRef="Activity_1kz9yoy" targetRef="Activity_1xba2td" />
    <bpmn:endEvent id="Event_1ibshpz" name="Order Completed">
      <bpmn:incoming>Flow_0yuub72</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0yuub72" sourceRef="Activity_1xba2td" targetRef="Event_1ibshpz" />
